<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <EditText
        android:id="@+id/etDialNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter number"
        android:inputType="phone"
        android:textSize="28sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <GridLayout
        android:id="@+id/gridKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="24dp">

        <Button android:text="1" style="@style/DialKey" />
        <Button android:text="2" style="@style/DialKey" />
        <Button android:text="3" style="@style/DialKey" />
        <Button android:text="4" style="@style/DialKey" />
        <Button android:text="5" style="@style/DialKey" />
        <Button android:text="6" style="@style/DialKey" />
        <Button android:text="7" style="@style/DialKey" />
        <Button android:text="8" style="@style/DialKey" />
        <Button android:text="9" style="@style/DialKey" />
        <Button android:text="*" style="@style/DialKey" />
        <Button android:text="0" style="@style/DialKey" />
        <Button android:text="#" style="@style/DialKey" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnBackspace"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="⌫"
            android:textSize="20sp"
            android:layout_marginEnd="24dp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="📞"
            android:textSize="24sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDialStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="#888888"
        android:layout_marginTop="16dp" />

</LinearLayout>
