<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Number display area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <!-- Call status (caller name / call state) -->
        <TextView
            android:id="@+id/tvDialStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Number row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDialNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter number"
                android:textColorHint="@color/text_hint"
                android:textSize="38sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="start" />

            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_input_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Backspace"
                android:tint="@color/text_secondary"
                android:visibility="invisible" />

        </LinearLayout>
    </LinearLayout>

    <!-- Keypad -->
    <GridLayout
        android:id="@+id/gridKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <LinearLayout android:tag="1" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="1"/><TextView style="@style/DialKeySub" android:text=" "/></LinearLayout>
        <LinearLayout android:tag="2" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="2"/><TextView style="@style/DialKeySub" android:text="ABC"/></LinearLayout>
        <LinearLayout android:tag="3" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="3"/><TextView style="@style/DialKeySub" android:text="DEF"/></LinearLayout>
        <LinearLayout android:tag="4" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="4"/><TextView style="@style/DialKeySub" android:text="GHI"/></LinearLayout>
        <LinearLayout android:tag="5" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="5"/><TextView style="@style/DialKeySub" android:text="JKL"/></LinearLayout>
        <LinearLayout android:tag="6" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="6"/><TextView style="@style/DialKeySub" android:text="MNO"/></LinearLayout>
        <LinearLayout android:tag="7" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="7"/><TextView style="@style/DialKeySub" android:text="PQRS"/></LinearLayout>
        <LinearLayout android:tag="8" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="8"/><TextView style="@style/DialKeySub" android:text="TUV"/></LinearLayout>
        <LinearLayout android:tag="9" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="9"/><TextView style="@style/DialKeySub" android:text="WXYZ"/></LinearLayout>
        <LinearLayout android:tag="*" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="✱"/><TextView style="@style/DialKeySub" android:text=" "/></LinearLayout>
        <LinearLayout android:tag="0" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="0"/><TextView style="@style/DialKeySub" android:text="+"/></LinearLayout>
        <LinearLayout android:tag="#" style="@style/DialKey"><TextView style="@style/DialKeyNum" android:text="#"/><TextView style="@style/DialKeySub" android:text=" "/></LinearLayout>

    </GridLayout>

    <!-- Call button row -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_call"
            android:background="@drawable/bg_btn_answer"
            android:contentDescription="Call"
            android:scaleType="center" />

    </FrameLayout>

</LinearLayout>
