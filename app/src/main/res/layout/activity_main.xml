<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:text="CallBridge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:text="Phone B — Receiver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvTransport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="#888888"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etPhoneAIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone A IP (e.g. 192.168.1.100)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect to Phone A"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBatteryFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Fix Battery Optimization"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnOpenSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📩 Open SMS Inbox" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the IP shown on Phone A's screen, then tap Connect."
        android:textSize="13sp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#888888" />

</LinearLayout>
