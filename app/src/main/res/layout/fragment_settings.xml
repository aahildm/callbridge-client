<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:text="CallBridge Setup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPhoneAIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone A IP (e.g. 192.168.1.100)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect to Phone A"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnForceWifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📶 Use WiFi"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnForceBluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔵 Use Bluetooth" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPairedDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBatteryFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Fix Battery Optimization"
        android:layout_marginBottom="10dp" />

    <!-- Critical for HyperOS/MIUI — without this, incoming call popups
         silently degrade to plain notifications -->
    <Button
        android:id="@+id/btnPopupPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Enable Call Popup Permission"
        android:backgroundTint="#5C6BC0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRestartApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Force Restart App"
        android:backgroundTint="#FF7043"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the IP shown on Phone A's screen, then tap Connect. If incoming calls only show as a notification instead of popping up, tap 'Enable Call Popup Permission' above."
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#888888" />

</LinearLayout>
