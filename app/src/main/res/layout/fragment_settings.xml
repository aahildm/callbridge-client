<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:text="CallBridge Setup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPairedDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔵 Connect via Bluetooth"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBatteryFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Fix Battery Optimization"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnPopupPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Enable Call Popup Permission"
        android:backgroundTint="#5C6BC0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnAudioProbe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 Run audio check on server"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRestartApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Force Restart App"
        android:backgroundTint="#FF7043"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Make sure Phone A (server) is paired with this phone in Bluetooth settings before connecting. If incoming calls only show as a notification instead of popping up, tap Enable Call Popup Permission."
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#888888" />

</LinearLayout>
