<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:text="CallBridge Setup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPhoneAIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone A IP (e.g. 192.168.1.100)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect to Phone A"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBatteryFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Fix Battery Optimization"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the IP shown on Phone A's screen, then tap Connect."
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#888888" />

</LinearLayout>
