<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_incall_screen"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="72dp"
    android:paddingBottom="48dp">

    <!-- "Incoming call" / "Calling" / "Ongoing call" -->
    <TextView
        android:id="@+id/tvCallLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming call"
        android:textSize="15sp"
        android:textColor="#BDC1C6"
        android:letterSpacing="0.02" />

    <!-- Avatar -->
    <FrameLayout
        android:id="@+id/avatar"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_avatar">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="44sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            android:contentDescription="Caller" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCaller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="34sp"
        android:textColor="#E8EAED"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textColor="#BDC1C6" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textColor="#BDC1C6"
        android:fontFamily="sans-serif"
        android:visibility="gone" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- In-call toggles: Mute / Speaker / Hold -->
    <LinearLayout
        android:id="@+id/rowInCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:id="@+id/ivMute"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:padding="20dp"
                android:background="@drawable/bg_incall_toggle"
                android:src="@drawable/ic_mic_off"
                android:contentDescription="Mute" />
            <TextView
                android:id="@+id/tvMuteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mute"
                android:textSize="13sp"
                android:textColor="#E8EAED" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:id="@+id/ivSpeaker"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:padding="20dp"
                android:background="@drawable/bg_incall_toggle"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="Speaker" />
            <TextView
                android:id="@+id/tvSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Speaker"
                android:textSize="13sp"
                android:textColor="#E8EAED" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:id="@+id/ivHold"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:padding="20dp"
                android:background="@drawable/bg_incall_toggle"
                android:src="@drawable/ic_pause"
                android:contentDescription="Hold" />
            <TextView
                android:id="@+id/tvHoldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hold"
                android:textSize="13sp"
                android:textColor="#E8EAED" />
        </LinearLayout>
    </LinearLayout>

    <!-- Decline / Answer (incoming) — or a single End call button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/colReject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton
                android:id="@+id/btnReject"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_btn_decline"
                android:src="@drawable/ic_call_end"
                android:scaleType="center"
                android:contentDescription="Decline" />
            <TextView
                android:id="@+id/tvRejectLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Decline"
                android:textSize="14sp"
                android:textColor="#E8EAED" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/colAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton
                android:id="@+id/btnAnswer"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_btn_answer"
                android:src="@drawable/ic_call"
                android:scaleType="center"
                android:contentDescription="Answer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Answer"
                android:textSize="14sp"
                android:textColor="#E8EAED" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
